    (is (equalp m #(10f0 10f0 10f0 10f0 10f0 10f0 10f0 10f0 10f0)))
    (is (equalp md #(10d0 10d0 10d0 10d0 10d0 10d0 10d0 10d0 10d0)))))

(test matrix3.-
  (is (equalp (m3:- (a3) (b3)) #(-8f0 -6f0 -4f0 -2f0 0f0 2f0 4f0 6f0 8f0)))
  (is (equalp (m3d:- (a3d) (b3d)) #(-8d0 -6d0 -4d0 -2d0 0d0 2d0 4d0 6d0 8d0)))
  (let ((m (a3))
        (md (a3d)))
    (is (eq (m3:-! m m (b3)) m))
    (is (eq (m3d:-! md md (b3d)) md))
