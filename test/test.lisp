    (is (equalp md #(-8d0 -6d0 -4d0 -2d0 0d0 2d0 4d0 6d0 8d0)))))

(test matrix3.*
  (is (equalp (m3:* (a3) (b3)) #(90f0 114f0 138f0 54f0 69f0 84f0 18f0 24f0 30f0)))
  (is (equalp (m3d:* (a3d) (b3d)) #(90d0 114d0 138d0 54d0 69d0 84d0 18d0 24d0 30d0)))
  (is (equalp (m3:* (a3) (m3:id)) (a3)))
  (is (equalp (m3d:* (m3d:id) (a3d)) (a3d)))
  (let ((m (a3))
        (md (b3d)))
    (is (eq (m3:*! m m (b3)) m))
    (is (eq (m3d:*! md (a3d) md) md))
    (is (equalp m #(90f0 114f0 138f0 54f0 69f0 84f0 18f0 24f0 30f0)))
    (is (equalp md #(90d0 114d0 138d0 54d0 69d0 84d0 18d0 24d0 30d0)))))

(test matrix3.*v3
  (is (equalp (m3:*v3 (a3) (v3:new 1f0 2f0 3f0)) #(30f0 36f0 42f0)))
  (is (equalp (m3d:*v3 (a3d) (v3d:new 1d0 2d0 3d0)) #(30d0 36d0 42d0)))
  (is (equal (multiple-value-list (m3:*v3-values (a3) 1f0 2f0 3f0)) '(30f0 36f0 42f0)))
  (is (equal (multiple-value-list (m3d:*v3-values (a3d) 1d0 2d0 3d0)) '(30d0 36d0 42d0)))
  (let ((v (v3:new 1f0 2f0 3f0))
        (vd (v3d:new 1d0 2d0 3d0)))
    (is (eq (m3:*v3! v (a3) v) v))
    (is (eq (m3d:*v3! vd (a3d) vd) vd))
    (is (equalp v #(30f0 36f0 42f0)))
    (is (equalp vd #(30d0 36d0 42d0)))))

(test matrix3.transpose
  (is (equalp (m3:transpose (a3)) #(1f0 4f0 7f0 2f0 5f0 8f0 3f0 6f0 9f0)))
  (is (equalp (m3d:transpose (a3d)) #(1d0 4d0 7d0 2d0 5d0 8d0 3d0 6d0 9d0)))
  (let ((m (a3))
        (md (a3d)))
    (is (eq (m3:transpose! m m) m))
    (is (eq (m3d:transpose! md md) md))
    (is (equalp m #(1f0 4f0 7f0 2f0 5f0 8f0 3f0 6f0 9f0)))
    (is (equalp md #(1d0 4d0 7d0 2d0 5d0 8d0 3d0 6d0 9d0)))))

(test matrix3.columns
  (is (equalp (m3:get-column-vector (a3) 1) #(4f0 5f0 6f0)))
  (is (equalp (m3d:get-column-vector (a3d) 2) #(7d0 8d0 9d0)))
  (is (equal (multiple-value-list (m3:get-column-values (a3) 2)) '(7f0 8f0 9f0)))
  (is (equal (multiple-value-list (m3d:get-column-values (a3d) 0)) '(1d0 2d0 3d0)))
  (let ((v (v3:zero)))
    (is (eq (m3:get-column-vector! v (a3) 0) v))
    (is (equalp v #(1f0 2f0 3f0))))
  (let ((m (a3)))
    (is (equalp (m3:set-column-vector m (v3:new 10f0 11f0 12f0) 1)
                #(1f0 2f0 3f0 10f0 11f0 12f0 7f0 8f0 9f0)))
    (is (equalp (m3:set-column-values m 10f0 11f0 12f0 2)
                #(1f0 2f0 3f0 4f0 5f0 6f0 10f0 11f0 12f0)))
    (is (equalp (m3:set-column-vectors m (v3:new 1f0 0f0 0f0) (v3:new 0f0 1f0 0f0)
                                       (v3:new 0f0 0f0 1f0))
                m3:+id+))
    (is (equalp m (a3)))
    (is (eq (m3:set-column-values! m 10f0 11f0 12f0 0) m))
    (is (equalp m #(10f0 11f0 12f0 4f0 5f0 6f0 7f0 8f0 9f0))))
  (let ((md (a3d)))
    (is (eq (m3d:set-column-vectors! md (v3d:new 9d0 8d0 7d0) (v3d:new 6d0 5d0 4d0)
                                     (v3d:new 3d0 2d0 1d0))
            md))
    (is (equalp md (b3d)))
    (is (eq (m3d:set-column-vector! md (v3d:new 10d0 11d0 12d0) 2) md))
    (is (equalp md #(9d0 8d0 7d0 6d0 5d0 4d0 10d0 11d0 12d0)))))

(test matrix3.rows
  (is (equalp (m3:get-row-vector (a3) 1) #(2f0 5f0 8f0)))
  (is (equalp (m3d:get-row-vector (a3d) 2) #(3d0 6d0 9d0)))
  (is (equal (multiple-value-list (m3:get-row-values (a3) 0)) '(1f0 4f0 7f0)))
  (is (equal (multiple-value-list (m3d:get-row-values (a3d) 1)) '(2d0 5d0 8d0)))
  (let ((vd (v3d:zero)))
    (is (eq (m3d:get-row-vector! vd (a3d) 0) vd))
    (is (equalp vd #(1d0 4d0 7d0))))
  (let ((m (a3)))
    (is (equalp (m3:set-row-vector m (v3:new 10f0 11f0 12f0) 1)
                #(1f0 10f0 3f0 4f0 11f0 6f0 7f0 12f0 9f0)))
    (is (equalp (m3:set-row-values m 10f0 11f0 12f0 2)
                #(1f0 2f0 10f0 4f0 5f0 11f0 7f0 8f0 12f0)))
    (is (equalp (m3:set-row-vectors m (v3:new 1f0 4f0 7f0) (v3:new 2f0 5f0 8f0)
                                    (v3:new 3f0 6f0 9f0))
                (a3)))
    (is (equalp m (a3)))
    (is (eq (m3:set-row-vector! m (v3:new 10f0 11f0 12f0) 0) m))
    (is (equalp m #(10f0 2f0 3f0 11f0 5f0 6f0 12f0 8f0 9f0))))
  (let ((md (a3d)))
    (is (eq (m3d:set-row-vectors! md (v3d:new 1d0 2d0 3d0) (v3d:new 4d0 5d0 6d0)
                                  (v3d:new 7d0 8d0 9d0))
            md))
    (is (equalp md (m3d:transpose (a3d))))
    (is (eq (m3d:set-row-values! md 10d0 11d0 12d0 1) md))
    (is (equalp md #(1d0 10d0 7d0 2d0 11d0 8d0 3d0 12d0 9d0)))))

(test matrix3.diagonal
  (is (equalp (m3:set-diagonal-vector (a3) (v3:new 10f0 11f0 12f0))
              #(10f0 2f0 3f0 4f0 11f0 6f0 7f0 8f0 12f0)))
  (is (equalp (m3d:set-diagonal-values (a3d) 10d0 11d0 12d0)
              #(10d0 2d0 3d0 4d0 11d0 6d0 7d0 8d0 12d0)))
  (let ((m (a3))
        (out (m3:zero))
        (outd (m3d:zero)))
    (is (eq (m3:set-diagonal-values! out m 10f0 11f0 12f0) out))
    (is (equalp out #(10f0 2f0 3f0 4f0 11f0 6f0 7f0 8f0 12f0)))
    (is (equalp m (a3)))
    (is (eq (m3d:set-diagonal-vector! outd (a3d) (v3d:new 10d0 11d0 12d0)) outd))
    (is (equalp outd #(10d0 2d0 3d0 4d0 11d0 6d0 7d0 8d0 12d0)))))

(test matrix3.determinant
  (is (= (m3:determinant (c3)) 6f0))
  (is (= (m3d:determinant (c3d)) 6d0))
  (is (= (m3:determinant (a3)) 0f0))
  (is (= (m3d:determinant (a3d)) 0d0))
  (is (= (m3:determinant (m3:id)) 1f0))
  (is (= (m3d:determinant (m3d:id)) 1d0)))

(test matrix3.invert
  (is (m3:= (m3:* (c3) (m3:invert (c3))) m3:+id+))
  (is (m3d:= (m3d:* (c3d) (m3d:invert (c3d))) m3d:+id+))
  (is (m3:= (m3:invert (m3:invert (c3))) (c3)))
  (is (m3d:= (m3d:invert (m3d:invert (c3d))) (c3d)))
  (is (equalp (m3:invert (m3:id)) m3:+id+))
  (is (equalp (m3d:invert (m3d:id)) m3d:+id+))
  (let ((m (c3))
        (md (c3d)))
    (is (eq (m3:invert! m m) m))
    (is (eq (m3d:invert! md md) md))
    (is (m3:= (m3:* (c3) m) m3:+id+))
    (is (m3d:= (m3d:* (c3d) md) m3d:+id+)))
  (signals error (m3:invert (a3)))
  (signals error (m3d:invert (a3d))))

(test matrix3.trs
  (is (equalp (m3:trs 3f0 4f0 0f0 2f0 5f0) #(2f0 0f0 0f0 0f0 5f0 0f0 3f0 4f0 1f0)))
  (is (equalp (m3d:trs 3d0 4d0 0d0 2d0 5d0) #(2d0 0d0 0d0 0d0 5d0 0d0 3d0 4d0 1d0)))
  (is (equalp (m3:*v3 (m3:trs 3f0 4f0 0f0 2f0 5f0) (v3:new 1f0 1f0 1f0)) #(5f0 9f0 1f0)))
  (is (equalp (m3d:*v3 (m3d:trs 3d0 4d0 0d0 2d0 5d0) (v3d:new 1d0 1d0 1d0)) #(5d0 9d0 1d0)))
  (let ((m (m3:id))
        (md (m3d:id)))
    (is (eq (m3:trs! m 3f0 4f0 0f0 2f0 5f0) m))
    (is (eq (m3d:trs! md 3d0 4d0 0d0 2d0 5d0) md))
    (is (equalp m (m3:trs 3f0 4f0 0f0 2f0 5f0)))
    (is (equalp md (m3d:trs 3d0 4d0 0d0 2d0 5d0))))
  (is (m3:= (m3:trs 0f0 0f0 (/ s:+pi+ 2) 2f0 1f0)
            (m3:new 0f0 2f0 0f0 -1f0 0f0 0f0 0f0 0f0 1f0)))
  (is (m3d:= (m3d:trs 0d0 0d0 (/ sd:+pi+ 2) 2d0 1d0)
             (m3d:new 0d0 2d0 0d0 -1d0 0d0 0d0 0d0 0d0 1d0))))

(test matrix3.trs.clockwise
  (let ((world (m3:* (m3:trs 0f0 0f0 (/ s:+pi+ 2) 1f0 1f0) (m3:trs 10f0 0f0 0f0 1f0 1f0)))
        (worldd (m3d:* (m3d:trs 0d0 0d0 (/ sd:+pi+ 2) 1d0 1d0)
                       (m3d:trs 10d0 0d0 0d0 1d0 1d0))))
    (is (v2:= (m3:get-translation world) (v2:new 0f0 10f0) :abs-tol 1f-5))
    (is (v2d:= (m3d:get-translation worldd) (v2d:new 0d0 10d0)))))

(test matrix3.translation
  (let ((m (m3:trs 3f0 4f0 0.5f0 2f0 2f0))
        (md (m3d:trs 3d0 4d0 0.5d0 2d0 2d0))
        (v (v2:zero)))
    (is (equalp (m3:get-translation m) #(3f0 4f0)))
    (is (equalp (m3d:get-translation md) #(3d0 4d0)))
    (is (equal (multiple-value-list (m3:get-translation-values m)) '(3f0 4f0)))
    (is (equal (multiple-value-list (m3d:get-translation-values md)) '(3d0 4d0)))
    (is (eq (m3:get-translation! v m) v))
    (is (equalp v #(3f0 4f0)))))

(test matrix3.scale
  (let ((m (m3:trs 3f0 4f0 0f0 2f0 5f0))
        (md (m3d:trs 3d0 4d0 0d0 2d0 5d0))
        (vd (v2d:zero)))
    (is (equalp (m3:get-scale m) #(2f0 5f0)))
    (is (equalp (m3d:get-scale md) #(2d0 5d0)))
    (is (equal (multiple-value-list (m3:get-scale-values m)) '(2f0 5f0)))
    (is (equal (multiple-value-list (m3d:get-scale-values md)) '(2d0 5d0)))
    (is (eq (m3d:get-scale! vd md) vd))
    (is (equalp vd #(2d0 5d0))))
  (is (v2:= (m3:get-scale (m3:trs 0f0 0f0 0.5f0 3f0 3f0)) (v2:new 3f0 3f0)))
  (is (v2d:= (m3d:get-scale (m3d:trs 0d0 0d0 0.5d0 3d0 3d0)) (v2d:new 3d0 3d0)))
  (is (v2:= (m3:get-scale (m3:trs 0f0 0f0 0.5f0 2f0 5f0)) (v2:new 2f0 5f0)))
  (is (v2d:= (m3d:get-scale (m3d:trs 0d0 0d0 0.5d0 2d0 5d0)) (v2d:new 2d0 5d0)))
  (is (v2:= (m3:get-scale (m3:trs 0f0 0f0 (/ s:+pi+ 2) 2f0 1f0)) (v2:new 2f0 1f0)))
  (is (v2d:= (m3d:get-scale (m3d:trs 0d0 0d0 (/ sd:+pi+ 2) 2d0 1d0)) (v2d:new 2d0 1d0))))

(test matrix3.angle
  (is (= (m3:get-angle (m3:trs 3f0 4f0 0f0 2f0 5f0)) 0f0))
  (is (= (m3d:get-angle (m3d:trs 3d0 4d0 0d0 2d0 5d0)) 0d0))
  (is (s:= (m3:get-angle (m3:trs 0f0 0f0 0.5f0 3f0 3f0)) 0.5f0))
  (is (sd:= (m3d:get-angle (m3d:trs 0d0 0d0 0.5d0 3d0 3d0)) 0.5d0))
  (is (s:= (m3:get-angle (m3:trs 0f0 0f0 (/ s:+pi+ 2) 1f0 1f0)) (/ s:+pi+ 2)))
  (is (sd:= (m3d:get-angle (m3d:trs 0d0 0d0 (/ sd:+pi+ 2) 1d0 1d0)) (/ sd:+pi+ 2)))
  (is (s:= (m3:get-angle (m3:trs 0f0 0f0 0.5f0 2f0 5f0)) 0.5f0))
  (is (sd:= (m3d:get-angle (m3d:trs 0d0 0d0 0.5d0 2d0 5d0)) 0.5d0)))

(test matrix3.axis
  (let ((m (m3:trs 3f0 4f0 0f0 2f0 5f0))
        (md (m3d:trs 3d0 4d0 0d0 2d0 5d0))
        (v (v2:zero)))
    (is (equalp (m3:get-axis m :x) #(2f0 0f0)))
    (is (equalp (m3:get-axis m :y) #(0f0 5f0)))
    (is (equalp (m3d:get-axis md :x) #(2d0 0d0)))
    (is (equalp (m3d:get-axis md :y) #(0d0 5d0)))
    (is (eq (m3:get-axis! v m :y) v))
    (is (equalp v #(0f0 5f0)))))
