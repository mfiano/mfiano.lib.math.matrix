(in-package #:mfiano.lib.math.matrix/test)

(test matrix2.new
  (is (equalp (a2) #(1f0 2f0 3f0 4f0)))
  (is (equalp (a2d) #(1d0 2d0 3d0 4d0)))
  (is (not (eq (a2) (a2))))
  (is (not (eq (a2d) (a2d)))))

(test matrix2.constants
  (is (equalp m2:+zero+ #(0f0 0f0 0f0 0f0)))
  (is (equalp m2d:+zero+ #(0d0 0d0 0d0 0d0)))
  (is (equalp m2:+id+ #(1f0 0f0 0f0 1f0)))
  (is (equalp m2d:+id+ #(1d0 0d0 0d0 1d0))))

(test matrix2.values
  (is (equal (multiple-value-list (m2:values (a2))) '(1f0 2f0 3f0 4f0)))
  (is (equal (multiple-value-list (m2d:values (a2d))) '(1d0 2d0 3d0 4d0))))

(test matrix2.with-values
  (let ((m (a2))
        (md (a2d)))
    (m2:with-values ((a m) (b (b2)))
      (is (equal (list a00 a10 a01 a11) '(1f0 2f0 3f0 4f0)))
      (is (equal (list b00 b10 b01 b11) '(5f0 6f0 7f0 8f0)))
      (setf a01 9f0))
    (m2d:with-values ((a md))
      (is (equal (list a00 a10 a01 a11) '(1d0 2d0 3d0 4d0)))
      (setf a11 9d0))
    (is (equalp m #(1f0 2f0 9f0 4f0)))
    (is (equalp md #(1d0 2d0 3d0 9d0)))))

(test matrix2.=
  (is (m2:= (a2) (a2)))
  (is (m2d:= (a2d) (a2d)))
  (is (m2:= (a2) (m2:new 1.0000001f0 2f0 3f0 4f0)))
  (is (m2d:= (a2d) (m2d:new 1.0000001d0 2d0 3d0 4d0)))
  (is (not (m2:= (a2) (m2:new 1.001f0 2f0 3f0 4f0))))
  (is (not (m2d:= (a2d) (m2d:new 1.001d0 2d0 3d0 4d0))))
  (is (m2:= (a2) (m2:new 1.001f0 2f0 3f0 4f0) :abs-tol 1f-2))
  (is (m2d:= (a2d) (m2d:new 1.001d0 2d0 3d0 4d0) :abs-tol 1d-2))
  (is (not (m2:= (a2) (b2))))
  (is (not (m2d:= (a2d) (b2d)))))

(test matrix2.zero
  (is (equalp (m2:zero) m2:+zero+))
  (is (equalp (m2d:zero) m2d:+zero+))
  (is (m2:zero? (m2:zero)))
  (is (m2d:zero? (m2d:zero)))
  (is (not (m2:zero? (a2))))
  (is (not (m2d:zero? (a2d))))
  (let ((m (a2))
        (md (a2d)))
    (is (eq (m2:zero! m) m))
    (is (eq (m2d:zero! md) md))
    (is (m2:zero? m))
    (is (m2d:zero? md))))

(test matrix2.id
  (is (equalp (m2:id) m2:+id+))
  (is (equalp (m2d:id) m2d:+id+))
  (is (m2:id? (m2:id)))
  (is (m2d:id? (m2d:id)))
  (is (not (m2:id? (a2))))
  (is (not (m2d:id? (a2d))))
  (let ((m (a2))
        (md (a2d)))
    (is (eq (m2:id! m) m))
    (is (eq (m2d:id! md) md))
    (is (m2:id? m))
    (is (m2d:id? md))))

(test matrix2.copy
  (let ((m (a2))
        (md (a2d))
        (out (m2:zero))
        (outd (m2d:zero)))
    (is (equalp (m2:copy m) m))
    (is (equalp (m2d:copy md) md))
    (is (not (eq (m2:copy m) m)))
    (is (not (eq (m2d:copy md) md)))
    (is (eq (m2:copy! out m) out))
    (is (eq (m2d:copy! outd md) outd))
    (is (equalp out m))
    (is (equalp outd md))))

(test matrix2.+
  (is (equalp (m2:+ (a2) (b2)) #(6f0 8f0 10f0 12f0)))
  (is (equalp (m2d:+ (a2d) (b2d)) #(6d0 8d0 10d0 12d0)))
  (let ((m (a2))
        (md (a2d)))
    (is (eq (m2:+! m m (b2)) m))
    (is (eq (m2d:+! md md (b2d)) md))
    (is (equalp m #(6f0 8f0 10f0 12f0)))
    (is (equalp md #(6d0 8d0 10d0 12d0)))))

(test matrix2.-
  (is (equalp (m2:- (a2) (b2)) #(-4f0 -4f0 -4f0 -4f0)))
  (is (equalp (m2d:- (a2d) (b2d)) #(-4d0 -4d0 -4d0 -4d0)))
  (let ((m (a2))
        (md (a2d)))
    (is (eq (m2:-! m m (b2)) m))
    (is (eq (m2d:-! md md (b2d)) md))
    (is (equalp m #(-4f0 -4f0 -4f0 -4f0)))
    (is (equalp md #(-4d0 -4d0 -4d0 -4d0)))))

(test matrix2.*
  (is (equalp (m2:* (a2) (b2)) #(23f0 34f0 31f0 46f0)))
  (is (equalp (m2d:* (a2d) (b2d)) #(23d0 34d0 31d0 46d0)))
  (is (equalp (m2:* (a2) (m2:id)) (a2)))
  (is (equalp (m2d:* (a2d) (m2d:id)) (a2d)))
  (let ((m (a2))
        (md (a2d)))
    (is (eq (m2:*! m m (b2)) m))
    (is (eq (m2d:*! md md (b2d)) md))
    (is (equalp m #(23f0 34f0 31f0 46f0)))
    (is (equalp md #(23d0 34d0 31d0 46d0)))))

(test matrix2.*v2
  (is (equalp (m2:*v2 (a2) (v2:new 5f0 6f0)) #(23f0 34f0)))
  (is (equalp (m2d:*v2 (a2d) (v2d:new 5d0 6d0)) #(23d0 34d0)))
  (let ((v (v2:new 5f0 6f0))
        (vd (v2d:new 5d0 6d0)))
    (is (eq (m2:*v2! v (a2) v) v))
    (is (eq (m2d:*v2! vd (a2d) vd) vd))
    (is (equalp v #(23f0 34f0)))
    (is (equalp vd #(23d0 34d0)))))

(test matrix2.transpose
  (is (equalp (m2:transpose (a2)) #(1f0 3f0 2f0 4f0)))
  (is (equalp (m2d:transpose (a2d)) #(1d0 3d0 2d0 4d0)))
  (let ((m (a2))
        (md (a2d)))
    (is (eq (m2:transpose! m m) m))
    (is (eq (m2d:transpose! md md) md))
    (is (equalp m #(1f0 3f0 2f0 4f0)))
    (is (equalp md #(1d0 3d0 2d0 4d0)))))

(test matrix2.columns
  (is (equalp (m2:get-column-vector (a2) 0) #(1f0 2f0)))
  (is (equalp (m2d:get-column-vector (a2d) 1) #(3d0 4d0)))
  (is (equal (multiple-value-list (m2:get-column-values (a2) 1)) '(3f0 4f0)))
  (is (equal (multiple-value-list (m2d:get-column-values (a2d) 0)) '(1d0 2d0)))
  (let ((v (v2:zero)))
    (is (eq (m2:get-column-vector! v (a2) 1) v))
    (is (equalp v #(3f0 4f0))))
  (let ((m (a2)))
    (is (equalp (m2:set-column-vector m (v2:new 9f0 8f0) 1) #(1f0 2f0 9f0 8f0)))
    (is (equalp (m2:set-column-values m 9f0 8f0 0) #(9f0 8f0 3f0 4f0)))
    (is (equalp m (a2)))
    (is (eq (m2:set-column-values! m 9f0 8f0 1) m))
    (is (equalp m #(1f0 2f0 9f0 8f0))))
  (let ((md (a2d)))
    (is (equalp (m2d:set-column-vector md (v2d:new 9d0 8d0) 0) #(9d0 8d0 3d0 4d0)))
    (is (eq (m2d:set-column-vector! md (v2d:new 9d0 8d0) 1) md))
    (is (equalp md #(1d0 2d0 9d0 8d0)))))

(test matrix2.rows
  (is (equalp (m2:get-row-vector (a2) 0) #(1f0 3f0)))
  (is (equalp (m2d:get-row-vector (a2d) 1) #(2d0 4d0)))
  (is (equal (multiple-value-list (m2:get-row-values (a2) 1)) '(2f0 4f0)))
  (is (equal (multiple-value-list (m2d:get-row-values (a2d) 0)) '(1d0 3d0)))
  (let ((vd (v2d:zero)))
    (is (eq (m2d:get-row-vector! vd (a2d) 0) vd))
    (is (equalp vd #(1d0 3d0))))
  (let ((m (a2)))
    (is (equalp (m2:set-row-vector m (v2:new 9f0 8f0) 0) #(9f0 2f0 8f0 4f0)))
    (is (equalp (m2:set-row-values m 9f0 8f0 1) #(1f0 9f0 3f0 8f0)))
    (is (equalp m (a2)))
    (is (eq (m2:set-row-vector! m (v2:new 9f0 8f0) 1) m))
    (is (equalp m #(1f0 9f0 3f0 8f0))))
  (let ((md (a2d)))
    (is (equalp (m2d:set-row-values md 9d0 8d0 0) #(9d0 2d0 8d0 4d0)))
    (is (eq (m2d:set-row-values! md 9d0 8d0 1) md))
    (is (equalp md #(1d0 9d0 3d0 8d0)))))

(test matrix3.new
  (is (equalp (a3) #(1f0 2f0 3f0 4f0 5f0 6f0 7f0 8f0 9f0)))
  (is (equalp (a3d) #(1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0 9d0)))
  (is (not (eq (a3) (a3))))
  (is (not (eq (a3d) (a3d)))))

(test matrix3.constants
  (is (equalp m3:+zero+ #(0f0 0f0 0f0 0f0 0f0 0f0 0f0 0f0 0f0)))
  (is (equalp m3d:+zero+ #(0d0 0d0 0d0 0d0 0d0 0d0 0d0 0d0 0d0)))
  (is (equalp m3:+id+ #(1f0 0f0 0f0 0f0 1f0 0f0 0f0 0f0 1f0)))
  (is (equalp m3d:+id+ #(1d0 0d0 0d0 0d0 1d0 0d0 0d0 0d0 1d0))))

(test matrix3.values
  (is (equal (multiple-value-list (m3:values (a3))) '(1f0 2f0 3f0 4f0 5f0 6f0 7f0 8f0 9f0)))
  (is (equal (multiple-value-list (m3d:values (a3d))) '(1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0 9d0))))

(test matrix3.with-values
  (let ((m (a3))
        (md (a3d)))
    (m3:with-values ((a m) (b (b3)))
      (is (equal (list a00 a10 a20 a01 a11 a21 a02 a12 a22)
                 '(1f0 2f0 3f0 4f0 5f0 6f0 7f0 8f0 9f0)))
      (is (equal (list b00 b11 b22) '(9f0 5f0 1f0)))
      (setf a21 10f0))
    (m3d:with-values ((a md))
      (is (equal (list a00 a10 a20 a01 a11 a21 a02 a12 a22)
                 '(1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0 9d0)))
      (setf a02 10d0))
    (is (equalp m #(1f0 2f0 3f0 4f0 5f0 10f0 7f0 8f0 9f0)))
    (is (equalp md #(1d0 2d0 3d0 4d0 5d0 6d0 10d0 8d0 9d0)))))

(test matrix3.=
  (is (m3:= (a3) (a3)))
  (is (m3d:= (a3d) (a3d)))
  (is (m3:= (a3) (m3:new 1f0 2f0 3f0 4f0 5f0 6f0 7f0 8f0 9.000001f0)))
  (is (m3d:= (a3d) (m3d:new 1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0 9.000001d0)))
  (is (not (m3:= (a3) (m3:new 1f0 2f0 3f0 4f0 5f0 6f0 7f0 8f0 9.01f0))))
  (is (not (m3d:= (a3d) (m3d:new 1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0 9.01d0))))
  (is (m3:= (a3) (m3:new 1f0 2f0 3f0 4f0 5f0 6f0 7f0 8f0 9.01f0) :rel-tol 1f-2))
  (is (m3d:= (a3d) (m3d:new 1d0 2d0 3d0 4d0 5d0 6d0 7d0 8d0 9.01d0) :rel-tol 1d-2))
  (is (not (m3:= (a3) (b3))))
  (is (not (m3d:= (a3d) (b3d)))))

