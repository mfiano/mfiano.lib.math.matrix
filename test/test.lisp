(test matrix3.+
  (is (equalp (m3:+ (a3) (b3)) #(10f0 10f0 10f0 10f0 10f0 10f0 10f0 10f0 10f0)))
  (is (equalp (m3d:+ (a3d) (b3d)) #(10d0 10d0 10d0 10d0 10d0 10d0 10d0 10d0 10d0)))
  (let ((m (a3))
        (md (a3d)))
    (is (eq (m3:+! m m (b3)) m))
